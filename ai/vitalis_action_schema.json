{
  "openapi": "3.1.0",
  "info": {
    "title": "Vitalis Live Health API",
    "description": "Live Vitalis health, training, and medical lab data API powered by Supabase.",
    "version": "1.3.0"
  },
  "servers": [
    {
      "url": "https://ltnlhxsdmcsjpcpxvvxl.supabase.co/functions/v1/vitalis-api"
    }
  ],
  "paths": {
    "/range-message": {
      "get": {
        "operationId": "getHealthRangeMessage",
        "summary": "Get Vitalis health data date range as text",
        "responses": {
          "200": {
            "description": "Health data range message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/latest-summary-message": {
      "get": {
        "operationId": "getLatestSummaryMessage",
        "summary": "Get latest Vitalis health snapshot as text",
        "responses": {
          "200": {
            "description": "Latest health snapshot message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/daily-brief-message": {
      "get": {
        "operationId": "getDailyBriefMessage",
        "summary": "Get latest Vitalis daily coach brief as text",
        "responses": {
          "200": {
            "description": "Daily coach brief message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
	
"/daily-hr-history-message": {
  "get": {
    "operationId": "getDailyHrHistoryMessage",
    "summary": "Get daily heart rate history",
    "description": "Returns latest available daily heart rate history including average, minimum, maximum, and sample count.",
    "responses": {
      "200": {
        "description": "Daily heart rate history message",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
},
"/workout-history-message": {
  "get": {
    "operationId": "getWorkoutHistoryMessage",
    "summary": "Get workout history",
    "description": "Returns latest available workout history including date, exercise type, duration, calories, distance, heart rate, and source.",
    "responses": {
      "200": {
        "description": "Workout history message",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
},
"/calorie-history-message": {
  "get": {
    "operationId": "getCalorieHistoryMessage",
    "summary": "Get calorie history",
    "description": "Returns latest available calorie history including active calories, rest calories, exercise calories, total burned calories, active time, and source.",
    "responses": {
      "200": {
        "description": "Calorie history message",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
},
"/lab-marker-history-message": {
  "get": {
    "operationId": "getLabMarkerHistoryMessage",
    "summary": "Get lab marker history",
    "description": "Returns historical lab results for a specific canonical lab marker, such as LDL, Hemoglobin, HbA1c, Vitamin D, or TSH.",
    "parameters": [
      {
        "name": "marker",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Canonical lab marker name, for example LDL, Hemoglobin, HbA1c, Vitamin D, or TSH."
      }
    ],
    "responses": {
      "200": {
        "description": "Lab marker history message",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
},	
	
    "/last-30-training-message": {
      "get": {
        "operationId": "getLast30TrainingMessage",
        "summary": "Get last 30 days training and recovery message",
        "responses": {
          "200": {
            "description": "Last 30 days training recovery message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/snapshot-message": {
      "get": {
        "operationId": "getSnapshotMessage",
        "summary": "Get Vitalis health snapshot for a specific date",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Date in YYYY-MM-DD format.",
            "schema": {
              "type": "string",
              "example": "2026-08-08"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Date-specific health snapshot message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/compare-periods-message": {
      "get": {
        "operationId": "compareHealthPeriodsMessage",
        "summary": "Compare Vitalis health data across two dates, months, years, or ranges",
        "parameters": [
          {
            "name": "period_a",
            "in": "query",
            "required": true,
            "description": "First period. Supports YYYY-MM-DD, YYYY-MM, YYYY, or YYYY-MM-DD..YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "example": "2026-08-01..2026-08-07"
            }
          },
          {
            "name": "period_b",
            "in": "query",
            "required": true,
            "description": "Second period. Supports YYYY-MM-DD, YYYY-MM, YYYY, or YYYY-MM-DD..YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "example": "2026-08-08..2026-08-14"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Health period comparison message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/latest-labs-message": {
      "get": {
        "operationId": "getLatestLabsMessage",
        "summary": "Get latest available medical lab rows as text",
        "responses": {
          "200": {
            "description": "Latest lab results message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/latest-labs-summary-message": {
      "get": {
        "operationId": "getLatestLabsSummaryMessage",
        "summary": "Get latest medical lab summary as text",
        "responses": {
          "200": {
            "description": "Latest lab summary message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/labs-by-period-message": {
      "get": {
        "operationId": "getLabsByPeriodMessage",
        "summary": "Get medical lab results for a date, month, year, or custom date range",
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "required": true,
            "description": "Period to search. Supports YYYY-MM-DD, YYYY-MM, YYYY, or YYYY-MM-DD..YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "example": "2022-10-25"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Medical labs for selected period",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
	
"/sleep-hr-history-message": {
  "get": {
    "operationId": "getSleepHrHistoryMessage",
    "summary": "Get sleep heart rate history",
    "description": "Returns latest available sleep heart rate history including average, minimum, maximum, and sample count.",
    "responses": {
      "200": {
        "description": "Sleep heart rate history message",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
},

	
	"/vo2-history-message": {
  "get": {
    "operationId": "getVo2HistoryMessage",
    "summary": "Get all measured VO2 max values from live Vitalis data",
    "responses": {
      "200": {
        "description": "Measured VO2 max history as plain text",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
},


"/sleep-hr-history-message": {
  "get": {
    "operationId": "getSleepHrHistoryMessage",
    "summary": "Get sleep heart-rate history from live Vitalis data",
    "parameters": [
      {
        "name": "days",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 90
        },
        "description": "Number of latest days to return. Defaults to 90."
      },
      {
        "name": "all",
        "in": "query",
        "required": false,
        "schema": {
          "type": "boolean",
          "default": false
        },
        "description": "Set true to return all imported sleep heart-rate history."
      }
    ],
    "responses": {
      "200": {
        "description": "Sleep heart-rate history as plain text",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
},
	

"/sync-health-status-message": {
  "get": {
    "operationId": "getSyncHealthStatusMessage",
    "summary": "Get latest synced health metric freshness status",
    "description": "Returns latest available synced dates for key Health Connect metrics and workouts, so Vitalis can judge whether live data is fresh before giving advice.",
    "responses": {
      "200": {
        "description": "Health sync freshness status message",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
},	

	
"/latest-workouts-message": {
  "get": {
    "operationId": "getLatestWorkoutsMessage",
    "summary": "Get latest workout sessions from live Vitalis data",
    "responses": {
      "200": {
        "description": "Latest workouts as plain text",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
},

"/workouts-by-period-message": {
  "get": {
    "operationId": "getWorkoutsByPeriodMessage",
    "summary": "Get workout sessions for a date, month, year, or date range",
    "parameters": [
      {
        "name": "period",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Period as YYYY-MM-DD, YYYY-MM, YYYY, or YYYY-MM-DD..YYYY-MM-DD"
      }
    ],
    "responses": {
      "200": {
        "description": "Workout sessions for the requested period as plain text",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
},


    "/compare-labs-message": {
      "get": {
        "operationId": "compareLabsMessage",
        "summary": "Compare medical lab results across two dates, months, years, or ranges",
        "parameters": [
          {
            "name": "period_a",
            "in": "query",
            "required": true,
            "description": "First period. Supports YYYY-MM-DD, YYYY-MM, YYYY, or YYYY-MM-DD..YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "example": "2022"
            }
          },
          {
            "name": "period_b",
            "in": "query",
            "required": true,
            "description": "Second period. Supports YYYY-MM-DD, YYYY-MM, YYYY, or YYYY-MM-DD..YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "example": "2023"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Medical lab comparison message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Plain text response generated by the Vitalis API."
          }
        },
        "required": ["message"],
        "additionalProperties": true
      }
    }
  }
}