{
  "openapi": "3.1.0",
  "info": {
    "title": "Vitalis Live Health API",
    "description": "Live API for reading Nimish's Vitalis health data from Supabase.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://ltnlhxsdmcsjpcpxvvxl.supabase.co/functions/v1/vitalis-api"
    }
  ],
  "paths": {
    "/range": {
      "get": {
        "operationId": "getHealthDataRange",
        "summary": "Get available health data date range",
        "description": "Returns the first health data date, latest health data date, and total daily snapshots available in Vitalis.",
        "responses": {
          "200": {
            "description": "Health data range",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "first_date": { "type": ["string", "null"] },
                    "latest_date": { "type": ["string", "null"] },
                    "total_snapshots": { "type": ["integer", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/latest-summary": {
      "get": {
        "operationId": "getLatestHealthSummary",
        "summary": "Get latest Vitalis health summary",
        "description": "Returns a compact latest daily health summary from Vitalis, including steps, sleep, heart rate, workouts, Samsung Sleep Score, and Samsung Energy Score where available.",
        "responses": {
          "200": {
            "description": "Latest health summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "latest_summary": {
                      "type": ["object", "null"],
                      "properties": {
                        "snapshot_date": { "type": ["string", "null"] },
                        "saved_at": { "type": ["string", "null"] },
                        "steps": { "type": ["integer", "null"] },
                        "distance_meters": { "type": ["number", "null"] },
                        "active_calories": { "type": ["number", "null"] },
                        "floors": { "type": ["number", "null"] },
                        "average_heart_rate": { "type": ["number", "null"] },
                        "minimum_heart_rate": { "type": ["integer", "null"] },
                        "maximum_heart_rate": { "type": ["integer", "null"] },
                        "resting_heart_rate": { "type": ["integer", "null"] },
                        "sleep_total_minutes": { "type": ["integer", "null"] },
                        "deep_sleep_minutes": { "type": ["integer", "null"] },
                        "rem_sleep_minutes": { "type": ["integer", "null"] },
                        "light_sleep_minutes": { "type": ["integer", "null"] },
                        "awake_minutes": { "type": ["integer", "null"] },
                        "sleep_session_count": { "type": ["integer", "null"] },
                        "sleep_score": { "type": ["number", "null"] },
                        "sleep_efficiency": { "type": ["number", "null"] },
                        "physical_recovery": { "type": ["number", "null"] },
                        "mental_recovery": { "type": ["number", "null"] },
                        "energy_score": { "type": ["number", "null"] },
                        "energy_sleep_score": { "type": ["number", "null"] },
                        "energy_activity_score": { "type": ["number", "null"] },
                        "workout_session_count": { "type": ["integer", "null"] },
                        "workout_total_duration_minutes": { "type": ["integer", "null"] },
                        "source": { "type": ["string", "null"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}