{
  "openapi": "3.1.0",
  "info": {
    "title": "Vitalis Live Health API",
    "description": "Live Vitalis health data API powered by Supabase.",
    "version": "1.2.0"
  },
  "servers": [
    {
      "url": "https://ltnlhxsdmcsjpcpxvvxl.supabase.co/functions/v1/vitalis-api"
    }
  ],
  "paths": {
    "/range": {
      "get": {
        "operationId": "getHealthDataRange",
        "summary": "Get Vitalis health data range",
        "responses": {
          "200": {
            "description": "Health data range"
          }
        }
      }
    },
    "/latest-summary": {
      "get": {
        "operationId": "getLatestHealthSummary",
        "summary": "Get latest Vitalis health summary",
        "responses": {
          "200": {
            "description": "Latest health summary"
          }
        }
      }
    },
    "/daily-brief": {
      "get": {
        "operationId": "getDailyBrief",
        "summary": "Get Vitalis daily coach brief",
        "responses": {
          "200": {
            "description": "Daily health coach brief"
          }
        }
      }
    },
    "/training-recovery": {
      "get": {
        "operationId": "getTrainingRecovery",
        "summary": "Get Vitalis training load and recovery windows",
        "responses": {
          "200": {
            "description": "Training recovery data for 7, 14, and 30 day windows"
          }
        }
      }
    },
    "/last-30-training-recovery": {
      "get": {
        "operationId": "getLast30TrainingRecovery",
        "summary": "Get last 30 days Vitalis training recovery summary",
        "description": "Returns one flat, GPT-friendly object summarizing the last 30 days of training load and recovery.",
        "responses": {
          "200": {
            "description": "Last 30 days training recovery summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "latest_health_date": {
                      "type": ["string", "null"]
                    },
                    "last_30_training_recovery": {
                      "type": ["object", "null"],
                      "properties": {
                        "period": {
                          "type": "string"
                        },
                        "workout_days": {
                          "type": "integer"
                        },
                        "workout_sessions": {
                          "type": "integer"
                        },
                        "workout_duration": {
                          "type": ["string", "null"]
                        },
                        "average_sleep": {
                          "type": ["string", "null"]
                        },
                        "average_energy_score": {
                          "type": ["number", "null"]
                        },
                        "average_heart_rate": {
                          "type": ["number", "null"]
                        },
                        "average_resting_heart_rate": {
                          "type": ["number", "null"]
                        },
                        "load": {
                          "type": "string"
                        },
                        "recovery": {
                          "type": "string"
                        },
                        "vitalis_note": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}